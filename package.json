  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "allure": "^3.22.1",
    "allure-js-commons": "^3.0.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "otplib": "^12.0.1"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  }
}
