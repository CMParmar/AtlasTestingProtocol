{
  "name": "atlas-create-task-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report reports/html",
    "test:createuser": "playwright test tests/createuser.spec.js",
    "test:createuser:headed": "playwright test tests/createuser.spec.js --headed",
    "test:createuser:positive": "playwright test tests/createuser.spec.js --grep @positive",
    "test:createuser:negative": "playwright test tests/createuser.spec.js --grep @negative",
    "test:serviceitem": "playwright test tests/createserviceitem.spec.js",
    "test:serviceitem:headed": "playwright test tests/createserviceitem.spec.js --headed --workers=1",
    "test:serviceitem:serial": "playwright test tests/createserviceitem.spec.js --workers=1",
    "test:serviceitem:positive": "playwright test tests/createserviceitem.spec.js --grep @positive",
    "test:serviceitem:negative": "playwright test tests/createserviceitem.spec.js --grep @negative",
    "test:viewupdate": "playwright test tests/viewupdateserviceitem.spec.js",
    "test:viewupdate:headed": "playwright test tests/viewupdateserviceitem.spec.js --headed --workers=1",
    "test:viewupdate:serial": "playwright test tests/viewupdateserviceitem.spec.js --workers=1",
    "test:viewupdate:positive": "playwright test tests/viewupdateserviceitem.spec.js --grep @positive",
    "test:viewupdate:negative": "playwright test tests/viewupdateserviceitem.spec.js --grep @negative",
    "test:viewupdate:allure": "npm run allure:clean && playwright test tests/viewupdateserviceitem.spec.js || echo Some tests failed - building the Allure report anyway && npm run allure:report",
    "test:workflow": "playwright test tests/createworklow.spec.js",
    "test:workflow:headed": "playwright test tests/createworklow.spec.js --headed --workers=1",
    "test:workflow:serial": "playwright test tests/createworklow.spec.js --workers=1",
    "test:workflow:positive": "playwright test tests/createworklow.spec.js --grep @positive",
    "test:workflow:negative": "playwright test tests/createworklow.spec.js --grep @negative",
    "test:workflow:allure": "npm run allure:clean && playwright test tests/createworklow.spec.js || echo Some tests failed - building the Allure report anyway && npm run allure:report",
    "test:workflowedit": "playwright test tests/vieweditworklow.spec.js --workers=1",
    "test:workflowedit:headed": "playwright test tests/vieweditworklow.spec.js --headed --workers=1",
    "test:workflowedit:serial": "playwright test tests/vieweditworklow.spec.js --workers=1",
    "test:workflowedit:positive": "playwright test tests/vieweditworklow.spec.js --grep @positive --workers=1",
    "test:workflowedit:negative": "playwright test tests/vieweditworklow.spec.js --grep @negative --workers=1",
    "test:workflowedit:allure": "npm run allure:clean && playwright test tests/vieweditworklow.spec.js --workers=1 || echo Some tests failed - building the Allure report anyway && npm run allure:report",
    "test:materialize": "playwright test tests/matirializeworklow.spec.js --workers=1",
    "test:materialize:headed": "playwright test tests/matirializeworklow.spec.js --headed --workers=1",
    "test:materialize:positive": "playwright test tests/matirializeworklow.spec.js --grep @positive --workers=1",
    "test:materialize:negative": "playwright test tests/matirializeworklow.spec.js --grep @negative --workers=1",
    "test:materialize:allure": "npm run allure:clean && playwright test tests/matirializeworklow.spec.js --workers=1 || echo Some tests failed - building the Allure report anyway && npm run allure:report",
    "test:publishworkflow": "playwright test tests/publishworklow.spec.js --workers=1",
    "test:publishworkflow:headed": "playwright test tests/publishworklow.spec.js --headed --workers=1",
    "test:publishworkflow:positive": "playwright test tests/publishworklow.spec.js --grep @positive --workers=1",
    "test:publishworkflow:negative": "playwright test tests/publishworklow.spec.js --grep @negative --workers=1",
    "test:publishworkflow:allure": "npm run allure:clean && playwright test tests/publishworklow.spec.js --workers=1 || echo Some tests failed - building the Allure report anyway && npm run allure:report",
    "test:serviceitem:allure": "npm run allure:clean && playwright test tests/createserviceitem.spec.js || echo Some tests failed - building the Allure report anyway && npm run allure:report",
    "allure:clean": "node -e \"require('fs').rmSync('reports/allure-results',{recursive:true,force:true})\"",
    "allure:generate": "allure generate reports/allure-results -o reports/allure-report --clean",
    "allure:open": "allure open reports/allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "allure": "^3.22.1",
    "allure-js-commons": "^3.0.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "otplib": "^12.0.1"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  }
}
